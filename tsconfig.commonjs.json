{
    "compilerOptions": {
        "declaration": true,
        "target": "es2019",
        "alwaysStrict": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "sourceMap": false,
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "module": "CommonJS",
        "esModuleInterop": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "noEmitHelpers": true,
        "allowSyntheticDefaultImports": true,
        "lib": ["es2019", "dom", "esnext.asynciterable"],
        "rootDir": "src",
        "outDir": "lib/commonjs"
    },
    "include": [
        "src/extensions/remote-session/server/**/*.ts",
        "src/servers/common/swagger-ui/**/*.ts",
        "src/servers/yml-server/**/*.ts",
        "src/servers/trajectory-registry/**/*.ts",
        "src/servers/topology-registry/**/*.ts",
        "src/mol-util/make-dir.ts",
        "src/mol-util/string.ts"
    ]
}
