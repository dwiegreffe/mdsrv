FROM node:20-alpine

# Base: Slim Alpine image with Node.js 20 runtime

# Required system tools for building and Git clone
RUN apk add --no-cache bash git openssh curl gnupg tar

# Clone the source (for reproducible builds, consider pinning to a commit or tag)
RUN git clone https://github.com/dwiegreffe/mdsrv.git

# Install JS/TS dependencies
RUN cd mdsrv && npm install

# Production build: produces build/viewer/* (incl. molstar bundle)
RUN cd mdsrv && NODE_ENV=production npm run build

# Global tools:
# - http-server: serves static files
# - forever: not used directly here, but kept for potential process supervision
RUN npm install -g http-server \
	&& npm install -g forever

# Viewer port
EXPOSE 4242

# Script to rewrite the remote server URL before start
COPY change-url.sh /
RUN chmod +x change-url.sh

# Entrypoint behavior and where to look in the project:
# - The container ENTRYPOINT is /change-url.sh. It optionally takes a base URL as its first argument,
#   replaces the default remote server URL inside the built bundle, and then starts http-server on port 4242.
# - The static bundle served is located under: mdsrv/build/viewer/ (e.g., molstar.js)
# - That bundle is generated by webpack from TypeScript sources in: src/apps/viewer/
#     Entry file: src/apps/viewer/index.ts (and app.ts)
#     Webpack config: webpack.config.viewer.js
# - To change viewer behavior, edit files in src/apps/viewer/, run `npm run build`, and rebuild the image.
#   Do not edit files under build/viewer/ directly; they are build output.
ENTRYPOINT ["/change-url.sh"]