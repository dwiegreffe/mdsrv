FROM node:20-alpine

# Base: Slim Alpine image with Node.js 20 runtime

# Required system tools for building and Git clone
RUN apk add --no-cache bash git openssh curl gnupg tar

# Note: Yarn is already present in node:alpine; this ENV is informational and has no practical effect here
ENV YARN_VERSION=1.22.15

# Clone the source (not pinned to a commit/tag — consider pinning for reproducible builds)
RUN git clone https://github.com/dwiegreffe/mdsrv.git

# fetch
# checkout

# Install all JS/TS dependencies (prod & dev needed to build)
RUN cd mdsrv && npm install

# Build into lib/commonjs/... (NODE_ENV=production for optimized bundles)
RUN cd mdsrv && NODE_ENV=production npm run build

# Set the working directory to the cloned repo so subsequent commands don't need 'cd'
WORKDIR /mdsrv

# Exposed port of the Remote Session / Trajectory server
EXPOSE 1337

# Start the Remote Session server (no extra 'cd' needed).
# Parameters:
#  --working-folder ./server   Path (relative to WORKDIR) for sessions/trajectories (mount a volume to persist data)
#  --port 1337                 Server port
#
# Source mapping and where to look:
#  Entry point executed by CMD: lib/commonjs/extensions/remote-session/server/index.js
#  This file is generated by the build from TypeScript sources under:
#    src/extensions/remote-session/server/
#  To understand or change server behavior, inspect/edit those sources (e.g., index.ts, config.ts),
#  then rebuild the project (npm run build) and rebuild this image. Do not edit lib/commonjs directly; it is build output.
CMD ["node", "lib/commonjs/extensions/remote-session/server/index.js", "--working-folder", "./server", "--port", "1337"]