events {}

http {
    server {
        listen 1337;
        client_max_body_size ${MDSRV_CLIENT_MAX_BODY_SIZE};

        location = / {
            return 302 /docs/;
        }

        location = /health {
            default_type application/json;
            return 200 '{"status":"ok"}';
        }

        location = /docs {
            return 302 /docs/;
        }

        location /docs/ {
            alias /usr/share/nginx/html/;
            try_files $uri $uri/ /index.html;
        }

        location = /api/v1/openapi.json {
            alias /usr/share/nginx/html/openapi.json;
            default_type application/json;
        }

        location /api/v1/yaml/ {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_YAML_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/v1/yaml {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_YAML_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/session/ {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_SESSION_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/v1/session {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_SESSION_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/trajectory/ {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_TRAJECTORY_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/v1/trajectory {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_TRAJECTORY_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/v1/topology/ {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_TOPOLOGY_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/v1/topology {
            proxy_http_version 1.1;
            proxy_pass http://${MDSRV_TOPOLOGY_UPSTREAM};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            return 404;
        }
    }
}
