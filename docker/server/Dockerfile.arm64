FROM node:16-alpine

WORKDIR /app

# Native modules may need build tooling during npm install.
RUN apk add --no-cache python3 make g++

COPY . .

RUN rm -rf node_modules \
    && npm install \
    && NODE_ENV=production npm run build \
    && node docker/server/inject-request-logs.js /app/lib/commonjs/extensions/remote-session/server/index.js \
    && mkdir -p /mdsrv/server

EXPOSE 1337

CMD ["node", "lib/commonjs/extensions/remote-session/server/index.js", "--working-folder", "/mdsrv/server", "--port", "1337"]
