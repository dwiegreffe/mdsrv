{
  "name": "mdsrv",
  "version": "0.1.0",
  "description": "Backend-only MDsrv API services.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean": "node ./scripts/clean.js",
    "build": "npm run build-tsc",
    "build-tsc": "tsc --build tsconfig.commonjs.json",
    "rebuild": "npm run clean && npm run build",
    "remote-session": "node lib/commonjs/extensions/remote-session/server/index.js",
    "yml-server": "node lib/commonjs/servers/yml-server/index.js",
    "trajectory-registry": "node lib/commonjs/servers/trajectory-registry/index.js",
    "topology-registry": "node lib/commonjs/servers/topology-registry/index.js"
  },
  "dependencies": {
    "argparse": "^2.0.1",
    "body-parser": "^1.20.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.17.3",
    "js-yaml": "^4.1.0",
    "node-fetch": "^2.6.7",
    "swagger-ui-dist": "^4.10.3",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@types/argparse": "^2.0.10",
    "@types/body-parser": "^1.19.2",
    "@types/compression": "1.7.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^16.11.26",
    "@types/node-fetch": "^2.6.1",
    "@types/swagger-ui-dist": "3.30.1",
    "typescript": "^4.6.3"
  }
}
